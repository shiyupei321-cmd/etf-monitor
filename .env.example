# ========================================
# ETF 定投监控 — 环境变量配置（模板）
# 复制为 .env 并填入真实值，.env 已加入 .gitignore
# ========================================

# 钉钉群机器人 Webhook（从钉钉群管理 → 机器人 → Webhook 获取）
DINGTALK_TOKEN=your_token_here
DINGTALK_SECRET=your_secret_here

# 溢价率买入阈值（当溢价率 < 此值时触发提醒，溢价越低越便宜，单位 %）
TARGET_PREMIUM=3.0

# 流动性风控阈值（万元）
TURNOVER_BILLION=10000
TURNOVER_HEALTHY=500
